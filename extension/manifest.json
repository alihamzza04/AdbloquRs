{
  "manifest_version": 3,
  "name": "AdbloquRs",
  "version": "1.0.0",
  "description": "Ad and tracker blocker with a Rust + WebAssembly engine. Blocks ads and tracking requests, per-site and per-domain exceptions. Includes YouTube video ad removal.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "activeTab",
    "webRequest",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["background/google-ima-shim.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["background/youtube-ad-remover.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_sdk_block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdbloquRs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["pkg/adblocker_wasm_bg.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}
