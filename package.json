    "build:wasm": "cd rust-adblock && wasm-pack build --target web --out-dir ../extension/pkg && npx wasm-opt -Oz --enable-bulk-memory --enable-sign-ext -o ../extension/pkg/adblocker_wasm_bg.opt.wasm ../extension/pkg/adblocker_wasm_bg.wasm && mv ../extension/pkg/adblocker_wasm_bg.opt.wasm ../extension/pkg/adblocker_wasm_bg.wasm",
    "build:extension": "npm run build:popup",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.34.0",
    "@eslint/js": "^9.39.4",
    "@types/chrome": "^0.2.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
